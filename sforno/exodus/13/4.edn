{:tier :glm-5.2, :verse 4, :comments ["<b>Neste dia vocês saem no mês do Aviv.</b> Naquele ano aconteceu que o mês lunar da partida de vocês caiu no mês do Aviv. Portanto, guardem este dia e façam a intercalação do ano, para que este mês caia para sempre no Aviv, no qual celebram esta festa."], :book "exodus", :voice :sforno, :lang :pt, :chapter 13, :timestamp "2026-07-27T20:25:27.422820674Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 2, :comments ["<b>Por honra.</b> Pela honra de El, bendito seja Ele, sendo eles vestes sagradas para o Seu serviço." "<b>E por esplendor.</b> Para que o sacerdote seja um mestre inspirador de temor a todos ao seu redor — sendo eles os discípulos inscritos sobre seu coração e ombros."], :book "exodus", :voice :sforno, :lang :pt, :chapter 28, :timestamp "2026-07-27T20:27:30.712278761Z", :translated-from :en, :model "glm-5.2"}
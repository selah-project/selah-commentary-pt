{:tier :glm-5.2, :verse 7, :comments ["<b>E tomou o seu mashal.</b> Ele proferiu aquele mashal que viu em sua profecia." "<b>E disse: De Aram.</b> Depois de recitar o mashal, ele interpretou o seu significado, e disse que o sentido do mashal era como de Aram Balak o conduziu, etc."], :book "numbers", :voice :sforno, :lang :pt, :chapter 23, :timestamp "2026-07-27T20:39:39.610506437Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 1, :comments ["<b>Estas são as jornadas.</b> O El, bendito seja Ele, desejou que as jornadas de Israel fossem escritas, para tornar conhecido o seu mérito em segui-Lo pelo deserto, em terra não semeada, de modo que foram dignos de entrar na terra."], :book "numbers", :voice :sforno, :lang :pt, :chapter 33, :timestamp "2026-07-27T20:40:13.933802748Z", :translated-from :en, :model "glm-5.2"}
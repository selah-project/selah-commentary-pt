{:tier :glm-5.2, :verse 9, :comments ["<b>Somente tu, por seres sua esposa.</b> Apenas no tocante à pessoa ele te reteve de mim." "<b>Este grande mal.</b> Retribuir o mal pelo bem." "<b>Estar com ela.</b> Em reclusão."], :book "genesis", :voice :sforno, :lang :pt, :chapter 39, :timestamp "2026-07-27T20:33:39.320770575Z", :translated-from :en, :model "glm-5.2"}
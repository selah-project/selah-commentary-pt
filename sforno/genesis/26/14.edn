{:tier :glm-5.2, :verse 14, :comments ["<b>E grande מַעֲבֻדָּה.</b> Terra cultivada pronta para ser trabalhada." "<b>E os pelishtim o invejavam.</b> Em seus próprios campos o contrário havia ocorrido então: semearam muito e colheram pouco."], :book "genesis", :voice :sforno, :lang :pt, :chapter 26, :timestamp "2026-07-27T20:31:41.890534221Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 31, :comments ["<b>Por que ficais de fora?</b> Visto que pedistes <b>um lugar para pernoitar</b> apenas os camelos — por que quereis ficar de fora, tu e teus homens?" "<b>E eu preparei a casa.</b> Para ti e para teus homens." "<b>E um lugar para os camelos.</b> E também preparei um lugar para os camelos."], :book "genesis", :voice :sforno, :lang :pt, :chapter 24, :timestamp "2026-07-27T20:31:24.199734679Z", :translated-from :en, :model "glm-5.2"}
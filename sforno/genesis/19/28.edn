{:tier :glm-5.2, :verse 28, :comments ["<b>E ele olhou.</b> Um olhar de inimizade, por causa da abundância de sua maldade." "<b>E olhou, e eis que a fumaça da terra subia.</b> E assim viu que já não havia mais lugar para orar por eles."], :book "genesis", :voice :sforno, :lang :pt, :chapter 19, :timestamp "2026-07-27T20:30:46.167107583Z", :translated-from :en, :model "glm-5.2"}
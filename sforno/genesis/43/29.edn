{:tier :glm-5.2, :verse 29, :comments ["<b>Que Elohim te conceda graça, meu filho.</b> Pois és o único de tua mãe, como disseram: וַיִּוָּתֵר הוּא לְבַדּוֹ לְאִמּוֹ (Gênesis 44:20) — que Elohim te conceda graça, para que teus irmãos e os outros te aproximem."], :book "genesis", :voice :sforno, :lang :pt, :chapter 43, :timestamp "2026-07-27T20:34:11.670945865Z", :translated-from :en, :model "glm-5.2"}
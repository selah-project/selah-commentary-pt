{:tier :glm-5.2, :verse 32, :comments ["<b>E dispuseram para ele à parte.</b> Para que seus irmãos não percebessem que ele é hebreu." "<b>Pois os egípcios não podiam.</b> Portanto ele não comia com seus irmãos, nem ele nem seus irmãos com os egípcios."], :book "genesis", :voice :sforno, :lang :pt, :chapter 43, :timestamp "2026-07-27T20:34:11.957962531Z", :translated-from :en, :model "glm-5.2"}
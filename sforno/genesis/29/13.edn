{:tier :glm-5.2, :verse 13, :comments ["<b>O relato de Jacó.</b> Que ele sozinho removeu a pedra." "<b>E ele contou a Lavã.</b> Para dar a conhecer que não tinha vindo a ele por causa de sustento, mas para escapar de seu irmão, e que estava ficando com ele por mandado de sua mãe."], :book "genesis", :voice :sforno, :lang :pt, :chapter 29, :timestamp "2026-07-27T20:32:08.983486986Z", :translated-from :en, :model "glm-5.2"}
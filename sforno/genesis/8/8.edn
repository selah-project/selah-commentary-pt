{:tier :glm-5.2, :verse 8, :comments ["<b>E enviou a pomba.</b> De cada espécie de pomba — havia sete pares de cada uma." "<b>Para ver se as águas tinham minguado.</b> Pois, se tivessem minguado, ela faria ninho nos montes e nas torres, como é seu hábito."], :book "genesis", :voice :sforno, :lang :pt, :chapter 8, :timestamp "2026-07-27T20:29:24.919346774Z", :translated-from :en, :model "glm-5.2"}
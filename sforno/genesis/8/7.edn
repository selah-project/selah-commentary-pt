{:tier :glm-5.2, :verse 7, :comments ["<b>E soltou o corvo.</b> Para ver se o ar tinha secado depois que os picos dos montes foram vistos, de modo que o corvo pudesse suportá-lo." "<b>E ele saía, indo e voltando.</b> Pois não conseguia suportá-lo."], :book "genesis", :voice :sforno, :lang :pt, :chapter 8, :timestamp "2026-07-27T20:29:24.418703488Z", :translated-from :en, :model "glm-5.2"}
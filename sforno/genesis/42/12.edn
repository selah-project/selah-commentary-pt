{:tier :glm-5.2, :verse 12, :comments ["<b>Não.</b> Não é verdade que vós sois irmãos." "<b>Mas para ver a nudez da terra viestes.</b> Antes, tramastes dizer que sois irmãos a fim de vir juntos e ver a nudez da terra."], :book "genesis", :voice :sforno, :lang :pt, :chapter 42, :timestamp "2026-07-27T20:34:00.794899560Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 43, :comments ["<b>Eu sou YHWH vosso Elohim.</b> Ele explica que todas estas coisas visam a um fim adequado a nós, dirigido por Ele, bendito seja — pois Ele é nosso Elohim; Ele não desviará os Seus olhos de nós."], :book "leviticus", :voice :sforno, :lang :pt, :chapter 23, :timestamp "2026-07-27T20:36:49.062354258Z", :translated-from :en, :model "glm-5.2"}
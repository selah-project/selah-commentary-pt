{:tier :glm-5.2, :verse 14, :comments ["<b>Sobre o seu ombro, e et a criança.</b> Significado: a ele também ele colocou sobre o seu ombro, já que ele não queria deixar a casa de seu pai; portanto, amarraram-no como uma criança e o colocaram sobre o seu ombro e a despediram."], :book "genesis", :voice :or-hachaim, :lang :pt, :chapter 21, :timestamp "2026-07-27T18:41:14.182611935Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 31, :comments ["<b>Vende-me hoje.</b> Por quanto quer que valha hoje, a saber, em proveito de desfrute, uma coisa pequena — pois se morreres em vida de meu pai não o herdarás, e o direito de primogenitura de nada te servirá."], :book "genesis", :voice :daat-zkenim, :lang :pt, :chapter 25, :timestamp "2026-07-30T15:36:17.874971879Z", :translated-from :en, :model "glm-5.2"}
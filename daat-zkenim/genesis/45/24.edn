{:tier :glm-5.2, :verse 24, :comments ["<b>Não te perturbes no caminho.</b> Não temas o perigo da estrada, pois Eu domino sobre toda a terra. E é como רגזו — 'não peques', e como לב רגז, que é traduzido como דחיל (temor)."], :book "genesis", :voice :daat-zkenim, :lang :pt, :chapter 45, :timestamp "2026-07-30T15:37:23.447004968Z", :translated-from :en, :model "glm-5.2"}
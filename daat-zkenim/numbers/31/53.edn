{:tier :glm-5.2, :verse 53, :comments ["<b>Os homens do exército saquearam cada um para si.</b> O saque, tais como vasos, bens móveis e vestimentas — estes eles não separaram deles para a congregação, mas antes, tudo o que cada homem saqueou era seu próprio."], :book "numbers", :voice :daat-zkenim, :lang :pt, :chapter 31, :timestamp "2026-07-30T15:40:31.446424603Z", :translated-from :en, :model "glm-5.2"}
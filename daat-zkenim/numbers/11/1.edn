{:tier :glm-5.2, :verse 1, :comments ["<b>E o povo foi como queixoso.</b> Como pranteadores pelos mortos, e afligidos pelo fato de que o Santo, bendito seja Ele, queria trazê-los à terra — pois eram de pouca fé e temiam a guerra."], :book "numbers", :voice :daat-zkenim, :lang :pt, :chapter 11, :timestamp "2026-07-30T15:39:04.813791351Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 16, :comments ["E todo aquele que tocar sobre a face do campo — isto é, aquele que entra na tenda onde está o cadáver torna-se impuro sem contato físico; mas se o cadáver estiver sobre a face do campo e não em uma tenda, transmite impureza apenas por contato."], :book "numbers", :voice :rashbam, :lang :pt, :chapter 19, :timestamp "2026-07-30T21:15:01.446869393Z", :translated-from :en, :model "glm-5.2"}
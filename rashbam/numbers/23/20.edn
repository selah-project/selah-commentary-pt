{:tier :glm-5.2, :verse 20, :comments ["<b>הן</b> <b>ברך</b> <b>לקחתי</b> — <b>הן</b> <b>לקחתי</b> <b>לברך</b> <b>אותם</b> <b>היום</b>, [<b>גזר</b>] <b>לברכם</b> <b>כבר</b>, <b>והוא</b> <b>ברך</b> <b>אותם</b> <b>כבר</b>, <b>ואותה</b> <b>הברכה</b> <b>לא</b> <b>אשיבנה</b>. <b>ו</b><b>ב</b><b>ר</b><b>ך</b> está no tempo passado, como <b>ח</b><b>ר</b><b>ף</b> <b>ע</b><b>ש</b><b>יו</b>."], :book "numbers", :voice :rashbam, :lang :pt, :chapter 23, :timestamp "2026-07-30T22:01:43.742917784Z", :translated-from :en, :model "glm-5.2"}
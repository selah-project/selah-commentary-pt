{:tier :glm-5.2, :verse 1, :comments ["Maskit — de שכה, assim como מרבית de רבה. E não encontro paralelo para isso exceto seu correspondente עברו משכיות לבב — a linguagem de 'reflexos do coração'; assim também aqui, uma pedra que tem imagens e figuras nela para se contemplar."], :book "leviticus", :voice :rashbam, :lang :pt, :chapter 26, :timestamp "2026-07-30T21:13:57.447350560Z", :translated-from :en, :model "glm-5.2"}
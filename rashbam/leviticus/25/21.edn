{:tier :glm-5.2, :verse 21, :comments ["Por três anos — segundo o sentido simples: o produto do sexto ano sustentará o sexto e o sétimo. E no oitavo eles plantarão e comerão do produto do sexto até o início do nono, quando serão sustentados pelo produto plantado no oitavo."], :book "leviticus", :voice :rashbam, :lang :pt, :chapter 25, :timestamp "2026-07-30T21:13:52.598260118Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 40, :comments ["E um ramo de árvore frondosa — tem um qamatz. Como קָדוֹשׁ, טָהוֹר, עָמוֹק, גָּדוֹל. Ou seja: um ramo de árvore densamente espessada."], :book "leviticus", :voice :rashbam, :lang :pt, :chapter 23, :timestamp "2026-07-30T21:13:47.425802517Z", :translated-from :en, :model "glm-5.2"}
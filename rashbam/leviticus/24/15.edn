{:tier :glm-5.2, :verse 15, :comments ["איש איש כי יקלל אלהיו — enuncia a designação claramente, sem especificar o Nome explícito. E especifica o Nome explícito — bendito seja Seu nome — em seguida: ונקב את שם יהוה."], :book "leviticus", :voice :rashbam, :lang :pt, :chapter 24, :timestamp "2026-07-30T21:13:48.994880058Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 19, :comments ["E Raquel furtou os terafim — para que não contassem nem informassem a Lavan que Yaakov intentava fugir, como está dito: אין אפוד ותרפים. Pois os terafim falavam enganosamente; eram acostumados a adivinhar por meio deles."], :book "genesis", :voice :rashbam, :lang :pt, :chapter 31, :timestamp "2026-07-30T21:10:48.753679812Z", :translated-from :en, :model "glm-5.2"}
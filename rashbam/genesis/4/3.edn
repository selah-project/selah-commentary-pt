{:tier :glm-5.2, :verse 3, :comments ["Uma oferenda — no sentido de um presente, derivado de נחה את העם. Ou seja: se ages bem, por não cometeres pecados exceto alguns, poderás suportar os teus pecados e os teus pecados não pesarão pesadamente sobre ti."], :book "genesis", :voice :rashbam, :lang :pt, :chapter 4, :timestamp "2026-07-30T21:09:16.567644586Z", :translated-from :en, :model "glm-5.2"}
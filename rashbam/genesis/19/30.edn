{:tier :glm-5.2, :verse 30, :comments ["Pois temia habitar em Zoar — porque o anjo o deixou ficar ali apenas porque ele não tinha tempo de fugir para a montanha. E agora que ele tinha tempo, cumpriu as palavras do anjo de habitar na montanha, para que Ele não destruísse a cidade."], :book "genesis", :voice :rashbam, :lang :pt, :chapter 19, :timestamp "2026-07-30T21:09:35.352056689Z", :translated-from :en, :model "glm-5.2"}
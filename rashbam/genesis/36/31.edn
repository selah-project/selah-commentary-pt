{:tier :glm-5.2, :verse 31, :comments ["Antes de um rei — antes de Moshé, que libertou Israel. Todo chefe de um povo é chamado 'rei' até David. Encontrei em Yosifon: após estes reis, perto de quarenta reis nominados pelo nome, um após o outro."], :book "genesis", :voice :rashbam, :lang :pt, :chapter 36, :timestamp "2026-07-30T21:11:15.464063258Z", :translated-from :en, :model "glm-5.2"}
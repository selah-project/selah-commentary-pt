{:tier :glm-5.2, :verse 16, :comments ["<b>E ele levará a sua iniquidade.</b> Ela é coagida, pois supõe que ele pode anular, e ela não tinha obrigação de aprender — mas ele tinha obrigação de aprender e não aprendeu; portanto, ele mesmo levará a iniquidade dela."], :book "numbers", :voice :chizkuni, :lang :pt, :chapter 30, :timestamp "2026-07-30T20:25:58.861937107Z", :translated-from :en, :model "glm-5.2"}
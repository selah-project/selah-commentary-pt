{:tier :glm-5.2, :verse 32, :comments ["<b>E ajuntaram as codornizes.</b> Defectivo no yod." "<b>Dez chomers.</b> Um chomer equivale a trinta se'ah; portanto, dez chomers comportam trezentos se'ah. Isso resulta em dez se'ah por dia, no mínimo."], :book "numbers", :voice :chizkuni, :lang :pt, :chapter 11, :timestamp "2026-07-30T20:23:22.097870307Z", :translated-from :en, :model "glm-5.2"}
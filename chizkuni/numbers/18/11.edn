{:tier :glm-5.2, :verse 11, :comments ["<b>Terumat matnam.</b> Com um vav defectivo, como <b>ארוכה מארץ מדה</b> — que é como se fosse <b>מדתה</b>; e <b>וגולה על ראשה</b> — como se fosse <b>וגולתה</b>; <b>הולך בשוק אצל פנה</b> — como se fosse <b>פנתה</b>."], :book "numbers", :voice :chizkuni, :lang :pt, :chapter 18, :timestamp "2026-07-30T20:24:13.262776433Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 17, :comments ["<b>Subi, este ao Negev.</b> O Negev da terra de Canaã." "<b>E subireis a montanha.</b> Uma vez que saibais como conquistar a montanha, o vale será fácil de conquistar." "<b>E subireis a montanha.</b> A montanha do amorreu."], :book "numbers", :voice :chizkuni, :lang :pt, :chapter 13, :timestamp "2026-07-30T20:23:35.473448453Z", :translated-from :en, :model "glm-5.2"}
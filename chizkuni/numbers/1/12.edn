{:tier :glm-5.2, :verse 12, :comments ["<b>De Dan.</b> Ele é mencionado primeiro entre os filhos das servas porque é o primogênito das servas; depois dele Asher, porque é o chefe dos que acampam ao redor do seu estandarte; e depois dele Gad, porque é o primogênito da serva de Leah."], :book "numbers", :voice :chizkuni, :lang :pt, :chapter 1, :timestamp "2026-07-30T20:22:00.766363108Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 19, :comments ["<b>E eles lhe disseram: pela estrada subiremos.</b> Pela estrada que passa fora das cidades. E disseram mais: e se a tua água bebermos — eu e meu gado — mesmo água de rios."], :book "numbers", :voice :chizkuni, :lang :pt, :chapter 20, :timestamp "2026-07-30T20:24:36.100773677Z", :translated-from :en, :model "glm-5.2"}
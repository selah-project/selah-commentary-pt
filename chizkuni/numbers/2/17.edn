{:tier :glm-5.2, :verse 17, :comments ["<b>E a Tenda do Encontro partirá.</b> O que está escrito, ״וארון ברית ה׳ נוסע לפניהם״ — essa é a arca que Moshé fez, na qual são colocados os fragmentos das tábuas, e é ela que sai com eles para a guerra."], :book "numbers", :voice :chizkuni, :lang :pt, :chapter 2, :timestamp "2026-07-30T20:22:06.626465776Z", :translated-from :en, :model "glm-5.2"}
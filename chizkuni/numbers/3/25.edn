{:tier :glm-5.2, :verse 25, :comments ["<b>O mishkan.</b> Estas são as cortinas de linho de fio retorcido." "<b>E a tenda.</b> Estas são as cortinas de pelos de cabra." "<b>Sua cobertura.</b> Estas são as peles de carneiro avermelhadas e as peles de tachash."], :book "numbers", :voice :chizkuni, :lang :pt, :chapter 3, :timestamp "2026-07-30T20:22:13.450575050Z", :translated-from :en, :model "glm-5.2"}
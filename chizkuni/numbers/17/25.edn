{:tier :glm-5.2, :verse 25, :comments ["<b>E o seu murmurar cessou.</b> ותכל — esperaria ותכלה; o seu murmurar — [a forma é] como וצו את יהושע, de יצוה. ותכס — [a forma é] como ותכסה, de כסה."], :book "numbers", :voice :chizkuni, :lang :pt, :chapter 17, :timestamp "2026-07-30T20:24:09.971953710Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 12, :comments ["<b>Todos os utensílios de serviço.</b> Facas, bacias, copas." "<b>E os colocarão sobre a vara.</b> Como é a prática para toda carga carregada em uma vara, e não sob a vara, para que a carga não arraste pelo chão."], :book "numbers", :voice :chizkuni, :lang :pt, :chapter 4, :timestamp "2026-07-30T20:22:18.374644708Z", :translated-from :en, :model "glm-5.2"}
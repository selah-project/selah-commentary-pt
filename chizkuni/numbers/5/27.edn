{:tier :glm-5.2, :verse 27, :comments ["<b>E ele fará com que ela beba as águas.</b> A letra he é mappiq." "<b>E a sua coxa cai.</b> O seu ventre é arruinado e ela já não é própria para relações íntimas — medida por medida."], :book "numbers", :voice :chizkuni, :lang :pt, :chapter 5, :timestamp "2026-07-30T20:22:30.896127001Z", :translated-from :en, :model "glm-5.2"}
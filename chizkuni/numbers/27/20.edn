{:tier :glm-5.2, :verse 20, :comments ["<b>E deporás sobre ele do teu esplendor.</b> Por analogia — não depositou sobre ele o esplendor da realeza; ou seja, honra-o perante eles, para que o honrem e lhe deem ouvidos."], :book "numbers", :voice :chizkuni, :lang :pt, :chapter 27, :timestamp "2026-07-30T20:25:39.257728356Z", :translated-from :en, :model "glm-5.2"}
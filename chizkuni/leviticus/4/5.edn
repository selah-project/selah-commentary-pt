{:tier :glm-5.2, :verse 5, :comments ["<b>E o sacerdote ungido tomará do sangue.</b> Tomar é mencionado aqui, e tomar é mencionado abaixo — assim como abaixo, o tomar é em um vaso, assim também aqui, o tomar é em um vaso."], :book "leviticus", :voice :chizkuni, :lang :pt, :chapter 4, :timestamp "2026-07-30T20:18:08.849965924Z", :translated-from :en, :model "glm-5.2"}
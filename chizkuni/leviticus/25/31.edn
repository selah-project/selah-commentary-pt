{:tier :glm-5.2, :verse 31, :comments ["<b>Mas as casas dos pátios.</b> Porque às vezes uma pessoa a transforma em um campo, portanto é contada como o campo da terra — já que são como um campo, isto é, seu resgate será seu, e no Jubileu ela sai."], :book "leviticus", :voice :chizkuni, :lang :pt, :chapter 25, :timestamp "2026-07-30T20:21:25.095649789Z", :translated-from :en, :model "glm-5.2"}
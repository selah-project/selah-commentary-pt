{:tier :glm-5.2, :verse 48, :comments ["<b>Ou na urdidura.</b> Uma expressão do fundamento do ofício, como השתות (fundamento), pois é a base." "<b>Ou na trama.</b> Assim chamado (ע״ש) porque mistura (מערב) os fios fiados juntos."], :book "leviticus", :voice :chizkuni, :lang :pt, :chapter 13, :timestamp "2026-07-30T20:19:24.693126528Z", :translated-from :en, :model "glm-5.2"}
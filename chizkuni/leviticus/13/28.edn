{:tier :glm-5.2, :verse 28, :comments ["<b>Não se estendeu na pele e é pálido.</b> 'É pálido' refere-se de volta a <b>'não se estendeu'</b>. Ou seja, não se estendeu e não é pálido, como ele explicou no caso de uma inflamação."], :book "leviticus", :voice :chizkuni, :lang :pt, :chapter 13, :timestamp "2026-07-30T20:19:20.290572351Z", :translated-from :en, :model "glm-5.2"}
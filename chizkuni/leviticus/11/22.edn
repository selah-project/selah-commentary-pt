{:tier :glm-5.2, :verse 22, :comments ["<b>O gafanhoto.</b> Da raiz de multiplicar." "<b>O סלעם.</b> Habita entre as rochas." "<b>O חרגל.</b> Compete com as suas pernas para pular com elas." "<b>O חגב.</b> Da raiz de ויסתבל — o חגב salta com as suas coxas e com as suas canelas."], :book "leviticus", :voice :chizkuni, :lang :pt, :chapter 11, :timestamp "2026-07-30T20:19:00.561435793Z", :translated-from :en, :model "glm-5.2"}
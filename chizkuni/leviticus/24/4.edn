{:tier :glm-5.2, :verse 4, :comments ["<b>Sobre a menorá pura.</b> Sobre a pureza da menorá — que ele não deve dispô-las com pavios e nós." "<b>Diante de HaShem.</b> Que ele não deve prepará-la fora e trazê-la para dentro."], :book "leviticus", :voice :chizkuni, :lang :pt, :chapter 24, :timestamp "2026-07-30T20:21:07.876535619Z", :translated-from :en, :model "glm-5.2"}
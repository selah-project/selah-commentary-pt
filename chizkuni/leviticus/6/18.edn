{:tier :glm-5.2, :verse 18, :comments ["<b>No lugar onde o holocausto é abatido.</b> A Escritura o repete, visto que não especificou acima, a respeito de todas as oferendas pelo pecado, que o seu abate é no lugar do abate do holocausto."], :book "leviticus", :voice :chizkuni, :lang :pt, :chapter 6, :timestamp "2026-07-30T20:18:25.982446791Z", :translated-from :en, :model "glm-5.2"}
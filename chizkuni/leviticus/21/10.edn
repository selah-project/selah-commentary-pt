{:tier :glm-5.2, :verse 10, :comments ["<b>Não deixará crescer soltos os seus cabelos e não rasgará as suas vestes.</b> Não lhe é permitido desfigurar-se sequer por luto. E disto aprendemos o que os Sábios disseram a respeito de um enlutado."], :book "leviticus", :voice :chizkuni, :lang :pt, :chapter 21, :timestamp "2026-07-30T20:20:38.848610707Z", :translated-from :en, :model "glm-5.2"}
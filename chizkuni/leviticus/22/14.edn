{:tier :glm-5.2, :verse 14, :comments ["<b>E acrescentará seu quinto a ele.</b> De modo que ele e seu quinto somem cinco. <b>E dará a coisa sagrada ao sacerdote</b> — dará ao sacerdote o quinto junto com a coisa sagrada."], :book "leviticus", :voice :chizkuni, :lang :pt, :chapter 22, :timestamp "2026-07-30T20:20:47.655212492Z", :translated-from :en, :model "glm-5.2"}
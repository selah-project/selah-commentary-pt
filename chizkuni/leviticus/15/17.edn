{:tier :glm-5.2, :verse 17, :comments ["<b>Do qual pode sair fluxo de semente.</b> Assim como o fluxo de semente mencionado abaixo está em seu estado natural, assim também o fluxo de semente mencionado aqui está em seu estado natural — excluindo o fluxo de semente que se putrefez."], :book "leviticus", :voice :chizkuni, :lang :pt, :chapter 15, :timestamp "2026-07-30T20:19:44.758759098Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 16, :comments ["<b>E o sacerdote mergulhará, do óleo.</b> מן no lugar da letra bet." "<b>E mergulhará e aspergirá.</b> Para cada aspersão, um mergulho." "<b>O seu lado direito.</b> O lugar que é visto, ou seja, o lado direito do rosto."], :book "leviticus", :voice :chizkuni, :lang :pt, :chapter 14, :timestamp "2026-07-30T20:19:32.266849175Z", :translated-from :en, :model "glm-5.2"}
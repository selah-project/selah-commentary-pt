{:tier :glm-5.2, :verse 2, :comments ["<b>Toma para ti um bezerro.</b> É o caminho do sacerdote oferecer um touro como oferta pelo pecado, conforme está escrito 'se o sacerdote' etc. — venha um bezerro e faça kapará pelo feito do bezerro."], :book "leviticus", :voice :chizkuni, :lang :pt, :chapter 9, :timestamp "2026-07-30T20:18:40.980678818Z", :translated-from :en, :model "glm-5.2"}
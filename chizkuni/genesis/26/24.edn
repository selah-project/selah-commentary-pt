{:tier :glm-5.2, :verse 24, :comments ["<b>Não temas, porque eu sou contigo.</b> Como ele estava sendo hostilizado por causa do ciúme dos filisteus e da contenda dos pastores de Gerar, o Santo, bendito seja, lhe apareceu e disse: Não temas."], :book "genesis", :voice :chizkuni, :lang :pt, :chapter 26, :timestamp "2026-07-30T20:14:34.947183577Z", :translated-from :en, :model "glm-5.2"}
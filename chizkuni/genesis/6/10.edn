{:tier :glm-5.2, :verse 10, :comments ["<b>E Noach gerou três filhos.</b> Uma vez que veio a mencionar Noach, que foi justo nas suas gerações, voltou atrás e mencionou seus filhos depois dele, pois a partir deles o mundo foi estabelecido."], :book "genesis", :voice :chizkuni, :lang :pt, :chapter 6, :timestamp "2026-07-30T20:11:52.828782049Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 18, :comments ["<b>Teu selo e teu cordão.</b> Ela lhe pediu estes itens porque ele precisava deles constantemente — seu selo para lacrar os nós da lã, e teu cordão para amarrar a lã, e teu cajado para se apoiar."], :book "genesis", :voice :chizkuni, :lang :pt, :chapter 38, :timestamp "2026-07-30T20:16:22.605887827Z", :translated-from :en, :model "glm-5.2"}
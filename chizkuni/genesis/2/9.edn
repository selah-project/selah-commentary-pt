{:tier :glm-5.2, :verse 9, :comments ["<b>E cresceu —</b> já havia crescido." "<b>E a árvore da vida no meio do jardim —</b> em seu meio." "<b>E a árvore do conhecimento do bem e do mal.</b> Como o seu Targum traduz: e a árvore cujo comedor conhece o bem e o mal."], :book "genesis", :voice :chizkuni, :lang :pt, :chapter 2, :timestamp "2026-07-30T20:11:13.512909359Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 20, :comments ["<b>Yizbeleni ishi.</b> Yizbol imi, como בני יצאוני גדוד יגודנו — formas que servem como duas. Outra interpretação: ele deve fazer uma morada para mim e para meus filhos, pois lhe gerei seis filhos."], :book "genesis", :voice :chizkuni, :lang :pt, :chapter 30, :timestamp "2026-07-30T20:15:13.414421606Z", :translated-from :en, :model "glm-5.2"}
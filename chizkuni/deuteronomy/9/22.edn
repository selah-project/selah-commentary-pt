{:tier :glm-5.2, :verse 22, :comments ["<b>E em Tav'erah</b> — este é Kivrot HaTa'avah. <b>E em Masah</b> — este é Refidim; na verdade, ele os chama pelo nome do evento, a fim de repreendê-los. E como Kivrot HaTa'avah tem dois nomes após o evento, ele o mencionou em ambos."], :book "deuteronomy", :voice :chizkuni, :lang :pt, :chapter 9, :timestamp "2026-07-30T20:01:51.029674249Z", :translated-from :en, :model "glm-5.2"}
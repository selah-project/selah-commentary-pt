{:tier :glm-5.2, :verse 11, :comments ["<b>E por que não achei favor</b> — defectivo, sem o alef. E a outra ocorrência, a respeito de Jó, ערום יצתי, é defectiva, sem o alef — para dizer: se não achei favor aos Teus olhos, por que saí do ventre de minha mãe."], :book "numbers", :voice :baal-haturim, :lang :pt, :chapter 11, :timestamp "2026-07-27T13:34:58.223126144Z", :translated-from :en, :model "glm-5.2"}
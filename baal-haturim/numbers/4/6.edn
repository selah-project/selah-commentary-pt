{:tier :glm-5.2, :verse 6, :comments ["A respeito da <b>arca</b> e do <b>altar de bronze</b> está escrito <b>seus varais</b> (בדיו), e a respeito da <b>mesa</b> e do <b>altar de ouro</b> está escrito <b>para as casas, para os varais</b> (לבתים לבדים) — e similarmente. <b>Seus varais</b>: para incluir as casas:"], :book "numbers", :voice :baal-haturim, :lang :pt, :chapter 4, :timestamp "2026-07-27T13:34:12.994379352Z", :translated-from :en, :model "glm-5.2"}
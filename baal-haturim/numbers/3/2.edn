{:tier :glm-5.2, :verse 2, :comments ["<b>Aharon, o primogênito, Nadav</b> — há um sinal de pontuação entre \"o primogênito\" e \"Nadav,\" para ensinar que não se refere a Nadav, porque Nadav morreu sem filhos e seu status de primogênito não tem consequência prática, mas sim se refere a Aharon, que é o primogênito para Moshé:"], :book "numbers", :voice :baal-haturim, :lang :pt, :chapter 3, :timestamp "2026-07-27T13:34:11.124037212Z", :translated-from :en, :model "glm-5.2"}
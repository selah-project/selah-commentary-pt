{:tier :glm-5.2, :verse 17, :comments ["<b>אל כלי</b> Duas vezes na Masorá: \"e porá sobre ela água viva אל כלי\" e a outra \"e não derramado de כלי אל כלי\" — pois a sua vitalidade deve estar em um כלי e não que se as derrame de כלי אל כלי."], :book "numbers", :voice :baal-haturim, :lang :pt, :chapter 19, :timestamp "2026-07-27T13:35:59.472962621Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 1, :comments ["<b>Se não o declarar, e levar a sua iniquidade</b> — אם לוא יגיד está escrito de forma plena com vav; leia-se como אם לו יגיד com um vav, significando: se já o tiver declarado, não o repete nem declara de novo."], :book "leviticus", :voice :baal-haturim, :lang :pt, :chapter 5, :timestamp "2026-07-27T13:31:41.973898488Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 3, :comments ["<b>וידום</b> — duas vezes: וידום אהרן e וידום השמש. Alusão ao que disseram: os luminares são afligidos por causa de um av bet din que morreu, e os filhos de Aharon eram av bet din."], :book "leviticus", :voice :baal-haturim, :lang :pt, :chapter 10, :timestamp "2026-07-27T13:31:56.886807802Z", :translated-from :en, :model "glm-5.2"}
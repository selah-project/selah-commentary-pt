{:tier :glm-5.2, :verse 2, :comments ["<b>E os consumiu</b> — אותם em guematria é זה הנפש. אותם está escrito plene com vav; eles pecaram em seis coisas: fogo estranho; eles julgaram na presença de seu mestre; embriagados com vinho; eles não tiveram filhos; eles fixaram os olhos no sustento; eles não buscaram conselho."], :book "leviticus", :voice :baal-haturim, :lang :pt, :chapter 10, :timestamp "2026-07-27T13:31:56.485821403Z", :translated-from :en, :model "glm-5.2"}
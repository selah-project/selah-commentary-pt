{:tier :glm-5.2, :verse 3, :comments ["<b>E um bezerro e um cordeiro</b> — cordeiro (כבש) para conquistar (לכבוש) o feito do bezerro e do carneiro, que estava dançando diante deles como um carneiro (כאיל). E isto é o que está escrito: 'e os fez dançar como um bezerro' (וירקידם כמו עגל)."], :book "leviticus", :voice :baal-haturim, :lang :pt, :chapter 9, :timestamp "2026-07-27T13:31:53.455093120Z", :translated-from :en, :model "glm-5.2"}
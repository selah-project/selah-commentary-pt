{:tier :glm-5.2, :verse 3, :comments ["<b>ואני אתן</b> — bet. Uma coisa, e a outra: ואני אתן את שכרך — que se ele se arrepender, ואני אתן שכרך — seus pecados lhe são contados como méritos:"], :book "leviticus", :voice :baal-haturim, :lang :pt, :chapter 20, :timestamp "2026-07-27T13:32:57.971117376Z", :translated-from :en, :model "glm-5.2"}
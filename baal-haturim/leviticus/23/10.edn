{:tier :glm-5.2, :verse 10, :comments ["<b>קצירה</b> — duas vezes: וקצרתם את קצירה, ביבוש, קצירה. Pois se vocês trazem o omer — וקצרתם את קצירה; e se não — ביבש, קצירה."], :book "leviticus", :voice :baal-haturim, :lang :pt, :chapter 23, :timestamp "2026-07-27T13:33:19.538470069Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 32, :comments ["<b>E terá uma boca</b> — correspondente a ele. Que o me'il expia o mau falar, pois se ele pecou com mau falar, deve fazer para si uma boca — para se abster do mau falar e fazer arrependimento, e isto lhe será expiado."], :book "exodus", :voice :baal-haturim, :lang :pt, :chapter 28, :timestamp "2026-07-27T13:25:18.930287897Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 16, :comments ["<b>ספר</b> Duas vezes na Masorá: aqui e na outra, הזכירני נשפטה יחד ספר אתה למען תצדק. Quando HaShem executa juízo sobre os ímpios, Seu nome é exaltado — isto é נשפטה יחד ספר שמי בכל הארץ, que Seu nome é exaltado por isso."], :book "exodus", :voice :baal-haturim, :lang :pt, :chapter 9, :timestamp "2026-07-27T13:22:16.848318940Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 24, :comments ["<b>Todo o ouro</b> — cinco tipos de ouro: חח (bracelete), נזם (anel para o nariz), טבעת (anel), כומז (pingente), e todos os vasos de ouro. Correspondente ao que lhes foi feito — cinco aflições: פרך (esmagamento), מרר (amargura), ענוי (aflição), לחץ (opressão), עבודה קשה (trabalho forçado)."], :book "exodus", :voice :baal-haturim, :lang :pt, :chapter 38, :timestamp "2026-07-27T13:26:22.904142308Z", :translated-from :en, :model "glm-5.2"}
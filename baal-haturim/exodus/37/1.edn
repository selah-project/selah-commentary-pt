{:tier :glm-5.2, :verse 1, :comments ["<b>E Bezalel fez a arca</b> — em todos eles Bezalel não é mencionado, apenas para a arca, para ensinar que Bezalel conhecia o segredo da arca e da Carruagem, pois a arca corresponde ao Trono da Glória:"], :book "exodus", :voice :baal-haturim, :lang :pt, :chapter 37, :timestamp "2026-07-27T13:26:19.173450354Z", :translated-from :en, :model "glm-5.2"}
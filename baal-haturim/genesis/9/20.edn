{:tier :glm-5.2, :verse 20, :comments ["<b>ויטע</b> Três vezes na Masorá: ויטע כרם. ויטע ה' אלהים גן בעדן. ויטע אשל. Nossos Rabinos expuseram: de onde ele tirou a muda? Do Jardim do Éden. E da mesma forma Avraham tomou o אשל do Jardim do Éden."], :book "genesis", :voice :baal-haturim, :lang :pt, :chapter 9, :timestamp "2026-07-27T13:27:22.959196014Z", :translated-from :en, :model "glm-5.2"}
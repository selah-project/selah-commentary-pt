{:tier :glm-5.2, :verse 32, :comments ["<b>E por que isto</b> — duas vezes na Massorá com hífen. A outra: ולמה זה הבל תהבלו (\"e por que isto — agirias com falsidade?\"). Ensina que ele negou o princípio fundamental e seguiu após הבל (vaidade/futilidade)."], :book "genesis", :voice :baal-haturim, :lang :pt, :chapter 25, :timestamp "2026-07-27T13:29:00.136745569Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 8, :comments ["<b>ספרו</b> — Três vezes na Masorá: aqui, e as outras: ספרו בגוים את כבודו — uma nos Salmos e uma em Crônicas. A respeito do relato que eles contaram — ספרו בגוים — a glória de Yosef, que eles o louvaram diante de Faraó."], :book "genesis", :voice :baal-haturim, :lang :pt, :chapter 40, :timestamp "2026-07-27T13:30:26.920754374Z", :translated-from :en, :model "glm-5.2"}
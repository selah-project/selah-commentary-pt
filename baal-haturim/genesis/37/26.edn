{:tier :glm-5.2, :verse 26, :comments ["<b>Que proveito</b> — duas vezes na Masorá: aqui e no outro מה בצע בדמי. E este é: מה בצע בדמי אם אהרוג את אחי — \"que proveito há no sangue se eu matar meu irmão.\""], :book "genesis", :voice :baal-haturim, :lang :pt, :chapter 37, :timestamp "2026-07-27T13:30:10.587896749Z", :translated-from :en, :model "glm-5.2"}
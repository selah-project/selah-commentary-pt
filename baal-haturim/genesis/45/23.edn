{:tier :glm-5.2, :verse 23, :comments ["<b>E provisões</b> — Duas vezes na Masorá: aqui, e a outra: ומזון לכלא ביה. Embora diga ומזון לאביו ומזון לכלא ביה — provisões para seu pai e provisões para todos ali — que ele enviou provisões para sustentar a todos."], :book "genesis", :voice :baal-haturim, :lang :pt, :chapter 45, :timestamp "2026-07-27T13:30:55.147780233Z", :translated-from :en, :model "glm-5.2"}
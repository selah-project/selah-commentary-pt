{:tier :glm-5.2, :verse 4, :comments ["<b>Não meterás a boca</b> — justaposto aos açoites, pois a correia com que se açoita é feita do couro de um bezerro, porque um boi conhece o seu dono (Isaías 1:3), e este não conhece o seu mestre; portanto é retribuído com uma correia de um bezerro."], :book "deuteronomy", :voice :baal-haturim, :lang :pt, :chapter 25, :timestamp "2026-07-27T13:19:20.549946938Z", :translated-from :en, :model "glm-5.2"}
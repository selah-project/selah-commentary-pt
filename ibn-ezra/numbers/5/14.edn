{:tier :glm-5.2, :verse 14, :comments ["<b>E um espírito passa sobre ele.</b> Gênero masculino, igualmente <b>ruach gadolah v'chazakah me'od</b> (um espírito grande e muito forte)." "E o sentido de <b>passa sobre</b> é que sobe em seu pensamento."], :book "numbers", :voice :ibn-ezra, :lang :pt, :chapter 5, :timestamp "2026-07-27T23:19:02.970265331Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 20, :comments ["<b>E olha para fora.</b> Forma feminina, por conta do vale." "<b>A desolação.</b> Um lugar desolado. A testemunha: «e em tohu sim yeshimon» (ele vagueia no deserto, no caminho desolado)."], :book "numbers", :voice :ibn-ezra, :lang :pt, :chapter 21, :timestamp "2026-07-27T23:21:22.178809509Z", :translated-from :en, :model "glm-5.2"}
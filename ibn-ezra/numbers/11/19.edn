{:tier :glm-5.2, :verse 19, :comments ["<b>Não comerás.</b> Duplicado." "<b>Cinco dias.</b> Correspondentes aos dedos da mão de comer." "<b>Dez.</b> Duplicado com ambas as suas mãos, também vinte, como a parábola dos que dizem: ele comerá tudo o que come com os dedos das mãos e dos pés."], :book "numbers", :voice :ibn-ezra, :lang :pt, :chapter 11, :timestamp "2026-07-27T23:19:50.921427150Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 12, :comments ["<b>Eu concebi.</b> Porventura fui eu a mãe deles?" "<b>O gerei.</b> Ou fui eu seu pai, como em ילד את שלח." "<b>Levá-lo.</b> Até que ele chegue à terra."], :book "numbers", :voice :ibn-ezra, :lang :pt, :chapter 11, :timestamp "2026-07-27T23:19:47.660447013Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 50, :comments ["<b>E trouxemos para perto.</b> Em pensamento ou em palavra." "<b>Braçadeira.</b> Está no braço, pois assim está escrito." "<b>E pulseira.</b> Para a mão." "<b>Anel.</b> No dedo." "<b>Brinco.</b> Nas orelhas, pois assim está escrito. Talvez seja chamado assim porque é redondo." "<b>E kumaz.</b> Como seus companheiros."], :book "numbers", :voice :ibn-ezra, :lang :pt, :chapter 31, :timestamp "2026-07-27T23:22:46.619347969Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 2, :comments ["<b>Levanta a cabeça.</b> Como כי תשא, e está explicado lá." "<b>À casa de seus pais.</b> Pois a família da mãe não é chamada família." "<b>Pelas suas cabeças.</b> Já o expliquei."], :book "numbers", :voice :ibn-ezra, :lang :pt, :chapter 1, :timestamp "2026-07-27T23:18:27.421621973Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 2, :comments ["<b>El a terra de Canaã.</b> Como 'e a profecia de Oded, o profeta' — a profecia é a profecia de Oded, o profeta. E o sentido é <b>el a terra:</b> a terra de Canaã."], :book "numbers", :voice :ibn-ezra, :lang :pt, :chapter 34, :timestamp "2026-07-27T23:22:59.194487528Z", :translated-from :en, :model "glm-5.2"}
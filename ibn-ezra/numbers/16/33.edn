{:tier :glm-5.2, :verse 33, :comments ["<b>E desceram.</b> O sentido: quando desceram, a terra se fechou e não foram mais vistos." "<b>E os cobriu.</b> A própria terra." "<b>E pereceram.</b> Por causa da morte de seus filhos que ficaram em seu lugar."], :book "numbers", :voice :ibn-ezra, :lang :pt, :chapter 16, :timestamp "2026-07-27T23:20:42.486209094Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 38, :comments ["<b>Ahiram.</b> Ele é Ahi-Shupham; Shupham é Mupham; Hupham é Huphim. E Ard e Naaman são os filhos de Bela. Alguns dizem que Naaman e Ard estão entre os que desceram ao Egito, e são filhos de Bela, filho de Binyamin."], :book "numbers", :voice :ibn-ezra, :lang :pt, :chapter 26, :timestamp "2026-07-27T23:22:12.384742947Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 10, :comments ["<b>A terceira vez</b><br>Então ela respondeu e disse: «Eu sou um muro» — [mantive minha fé] — e meus seios, que são as Torás, me guardaram. Então serei aos olhos da Shekhinah como quem encontra favor."], :book "song-of-songs", :voice :ibn-ezra, :lang :pt, :chapter 8, :timestamp "2026-07-27T23:47:24.476524125Z", :translated-from :en, :model "glm-5.2"}
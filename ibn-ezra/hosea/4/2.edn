{:tier :glm-5.2, :verse 2, :comments ["<b>אלה</b> — um juramento. E אלה é da raiz de אלה." "<b>פרצו</b> — da raiz de פריצים." "<b>ודמי</b> — o sangue de um morto toca o sangue de outro morto."], :book "hosea", :voice :ibn-ezra, :lang :pt, :chapter 4, :timestamp "2026-07-27T22:54:16.920967123Z", :translated-from :en, :model "glm-5.2"}
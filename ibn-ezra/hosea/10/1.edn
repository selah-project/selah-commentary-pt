{:tier :glm-5.2, :verse 1, :comments ["<b>Uma vinha estéril</b> — apenas não tem poder para dar fruto, e não há fruto." "<b>Ele a tornou como</b> — ele contou que daria o seu fruto, e ela se tornou como uma vinha estéril, pois quando multipliquei o seu fruto — eles multiplicaram os altares."], :book "hosea", :voice :ibn-ezra, :lang :pt, :chapter 10, :timestamp "2026-07-27T22:54:59.514653259Z", :translated-from :en, :model "glm-5.2"}
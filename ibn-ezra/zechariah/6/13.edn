{:tier :glm-5.2, :verse 13, :comments ["<b>E ele</b> — E quando a casa for edificada, então ele [Zerubavel] portará a majestade real, e Josué, o sumo sacerdote [portará a sua], e ele [cada um] se assentará no seu trono, e não haverá inveja entre eles por causa dos dois tronos."], :book "zechariah", :voice :ibn-ezra, :lang :pt, :chapter 6, :timestamp "2026-07-27T23:48:04.629085463Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 8, :comments ["<b>E acontecerá</b> — Isso é um sinal para o futuro, e por esta razão a montanha é fendida, para que do seu meio saiam águas vivas pelo caminho do vale, e de agora em diante a montanha não as bloqueará, pois está fendida."], :book "zechariah", :voice :ibn-ezra, :lang :pt, :chapter 14, :timestamp "2026-07-27T23:48:51.812176318Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 1, :comments ["<b>Nevuchadnetzar:</b> Romiyyah — a sua altura é a sua estatura." "<b>Potiyyah:</b> Sua largura era de seis côvados." "<b>Planície de Dura:</b> E habitavam ali; é a planície de Dura."], :book "daniel", :voice :ibn-ezra, :lang :pt, :chapter 3, :timestamp "2026-07-27T22:26:38.362828035Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 1, :comments ["<b>No primeiro ano de Belsazar</b> — Agora começo a explicar as profecias." "<b>O princípio do assunto ele disse</b> — Yefet disse: o princípio dos assuntos ele falou, e não todos os assuntos. E na minha opinião: assim é o princípio das palavras de Daniel."], :book "daniel", :voice :ibn-ezra, :lang :pt, :chapter 7, :timestamp "2026-07-27T22:27:17.412585727Z", :translated-from :en, :model "glm-5.2"}
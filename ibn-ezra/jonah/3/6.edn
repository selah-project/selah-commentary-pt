{:tier :glm-5.2, :verse 6, :comments ["<b>wayyigaʿ</b> [ele chegou]: isto é antes de vestir o pano de saco." "<b>wayyaʿabor</b> [ele passou]: ele removeu." "<b>wayyekhas</b> [ele cobriu]: seu corpo com pano de saco, pois é um verbo transitivo."], :book "jonah", :voice :ibn-ezra, :lang :pt, :chapter 3, :timestamp "2026-07-27T23:10:22.027992788Z", :translated-from :en, :model "glm-5.2"}
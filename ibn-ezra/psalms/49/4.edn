{:tier :glm-5.2, :verse 4, :comments ["<b>Minha boca</b> — ensina sobre toda sabedoria oculta deles, e o sábio de coração a mencionará por meio de enigma." "<b>E o sentido de \"eu pondero\" e \"eu discerno\"</b> — que meu coração ponderou."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 49, :timestamp "2026-07-27T23:34:01.516882791Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 2, :comments ["<b>Ouvi</b> — esta é a matéria que ele está prestes a dar a conhecer. Abrange todos os seres vivos nos quais HaShem soprou o fôlego de vida pelas Suas narinas; portanto: \"Dai ouvidos, todos os habitantes do mundo.\""], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 49, :timestamp "2026-07-27T23:34:01.505776455Z", :translated-from :en, :model "glm-5.2"}
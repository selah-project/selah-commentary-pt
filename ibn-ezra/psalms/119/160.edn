{:tier :glm-5.2, :verse 160, :comments ["<b>Cabeça</b> — O começo da palavra: «Todo mandamento teu que me ordenaste é verdade.» E disse o rabino Yeshuah: Alude à palavra אנכי (Eu) no monte Sinai."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 119, :timestamp "2026-07-27T23:43:51.061980620Z", :translated-from :en, :model "glm-5.2"}
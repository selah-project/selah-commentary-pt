{:tier :glm-5.2, :verse 2, :comments ["<b>Ashrei</b> — Ele falou primeiro sobre aquele que se exercita para andar no caminho reto; agora ele também mencionou aquele que guarda os testemunhos que recebeu dos pais, o principal deles sendo o testemunho do olho."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 119, :timestamp "2026-07-27T23:42:50.944844426Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 111, :comments ["<b>נחלתי</b> — O significado é: נחלתי, para que eu me regozije nela." "<b>ועדותיך</b> — São as maravilhas que Tu realizaste, que meus antepassados transmitiram, e me regozijo como se eu tivesse sido uma testemunha naqueles dias."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 119, :timestamp "2026-07-27T23:43:33.278638378Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 162, :comments ["<b>Eu me regozijo</b> — Aderente ao versículo anterior: não temi os príncipes, nem me preocupei; apenas me regozijei em Tuas palavras, como se tivesse vencido os príncipes e tomado o seu despojo."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 119, :timestamp "2026-07-27T23:43:51.464326606Z", :translated-from :en, :model "glm-5.2"}
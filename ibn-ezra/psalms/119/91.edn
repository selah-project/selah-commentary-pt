{:tier :glm-5.2, :verse 91, :comments ["<b>למשפטיך</b> — Ele mencionou os céus e a terra, e eles permanecem como servos para executar Teus julgamentos, à maneira do versículo: “Eu os convoco, que se apresentem juntos.”"], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 119, :timestamp "2026-07-27T23:43:24.170596158Z", :translated-from :en, :model "glm-5.2"}
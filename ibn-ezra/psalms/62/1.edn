{:tier :glm-5.2, :verse 1, :comments ["<b>Para o líder, de Yedutun.</b> A beleza do piyyut está em que o seu começo é 'de Yedutun': ou Yedutun, o poeta, o compôs, ou outro o compôs a seu respeito, pois é um instrumento distante."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 62, :timestamp "2026-07-27T23:35:18.190957238Z", :translated-from :en, :model "glm-5.2"}
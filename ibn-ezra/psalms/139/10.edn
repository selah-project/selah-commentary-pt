{:tier :glm-5.2, :verse 10, :comments ["<b>Mesmo lá</b> — eu não poderia ir aos confins do mar, a não ser que Tua mão me guiasse." "<b>E Tua mão me guia, e Tua destra me segura</b> — é como se eu estivesse fugindo de Tua mão para Tua mão."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 139, :timestamp "2026-07-27T23:45:02.902912955Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 5, :comments ["<b>און, sobre seu leito</b> — à noite." "<b>יתיצב</b> — o oposto de estar deitado, de dia." "<b>de modo que não é bom</b> — um mandamento negativo." "<b>não despreza o mal</b> — o sentido é duplo."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 36, :timestamp "2026-07-27T23:32:31.325484493Z", :translated-from :en, :model "glm-5.2"}
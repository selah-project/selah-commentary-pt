{:tier :glm-5.2, :verse 18, :comments ["<b>Perto</b> — Se o rei está longe, não pode salvar os que clamam a ele, mas HaShem está perto sempre — apenas para aqueles que O invocam em verdade e não para O testar, e para aquele que não é digno de ser salvo."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 145, :timestamp "2026-07-27T23:45:41.783484720Z", :translated-from :en, :model "glm-5.2"}
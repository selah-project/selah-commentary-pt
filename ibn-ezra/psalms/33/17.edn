{:tier :glm-5.2, :verse 17, :comments ["<b>Falsidade</b>: Porque HaShem disse: «Acaso dás tu ao cavalo a força?» — e o sentido diz respeito ao cavalo do rei e ao seu exército." "<b>Não livrará</b>: O pu'al é deficiente, e seu objeto é ele mesmo."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 33, :timestamp "2026-07-27T23:32:05.647724465Z", :translated-from :en, :model "glm-5.2"}
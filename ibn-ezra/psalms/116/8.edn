{:tier :glm-5.2, :verse 8, :comments ["<b>Pois</b> — muitas vezes tens resgatado a minha alma." "<b>E o olhar dos meus olhos</b> — que ele pensava que morreria, como em: 'e Ezequias chorou.'" "<b>E os meus pés</b> — pois por meio deles há movimento, para que ele possa fugir."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 116, :timestamp "2026-07-27T23:42:33.389958882Z", :translated-from :en, :model "glm-5.2"}
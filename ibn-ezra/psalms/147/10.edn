{:tier :glm-5.2, :verse 10, :comments ["<b>Não deseja</b> — o sentido: HaShem não deseja força, apenas o temor d'Ele, como em: «Dás tu ao cavalo a força.» E o sentido de: «O seu estrondo [é] o cavaleiro.»"], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 147, :timestamp "2026-07-27T23:45:51.679535395Z", :translated-from :en, :model "glm-5.2"}
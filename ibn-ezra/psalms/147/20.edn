{:tier :glm-5.2, :verse 20, :comments ["<b>Não o fez</b> — o sentido é que Ele não deu Sua Torá senão a Seu povo somente, pois os separou para ser Sua possessão preciosa. E o salmista concluiu como começou."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 147, :timestamp "2026-07-27T23:45:55.172470757Z", :translated-from :en, :model "glm-5.2"}
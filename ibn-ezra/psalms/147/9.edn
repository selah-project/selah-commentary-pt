{:tier :glm-5.2, :verse 9, :comments ["<b>Quem dá</b> — Ele mencionou os animais, pois não têm entendimento para preparar o seu próprio alimento." "<b>E Ele mencionou a ave, o filhote do corvo</b> — pois os sábios das nações dizem que seus pais os abandonam quando nascem."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 147, :timestamp "2026-07-27T23:45:51.220886607Z", :translated-from :en, :model "glm-5.2"}
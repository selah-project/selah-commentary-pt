{:tier :glm-5.2, :verse 2, :comments ["<b>Dá ouvidos, ó Elohim, à minha oração</b> — o sentido é o mesmo; \"dar ouvidos\" é à maneira do ouvido do homem." "<b>e não escondas</b> — [com] o olho, para ver como ele pleiteia diante de HaShem."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 55, :timestamp "2026-07-27T23:34:36.371997304Z", :translated-from :en, :model "glm-5.2"}
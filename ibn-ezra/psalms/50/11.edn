{:tier :glm-5.2, :verse 11, :comments ["<b>Eu sei</b>: O sentido de ידעתי é que não há no homem poder para conhecê-las todas, pois são muitas." "<b>Os seres que se movem pelo campo</b>: Pois estão no campo e o homem não tem dominado sobre eles, pois estão distantes das áreas habitadas."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 50, :timestamp "2026-07-27T23:34:13.987859874Z", :translated-from :en, :model "glm-5.2"}
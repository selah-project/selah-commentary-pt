{:tier :glm-5.2, :verse 12, :comments ["<b>Se</b> — Rabi Moshé disse: Se eu fosse como um homem que tem necessidades, não buscaria receber do que ele tem, quando ele tem apenas um pouco e tudo está em Minha mão — com muito mais razão [quando] eu não tenho necessidade."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 50, :timestamp "2026-07-27T23:34:14.443721719Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 10, :comments ["<b>כי, לי</b> — por minha causa, como em פן יאמרו אויבי לי." "<b>ושומרי נפשי</b> — aqueles que eu pensava que eram meus aliados, consultaram-se juntos com os meus inimigos."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 71, :timestamp "2026-07-27T23:36:29.119083069Z", :translated-from :en, :model "glm-5.2"}
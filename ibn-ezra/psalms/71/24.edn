{:tier :glm-5.2, :verse 24, :comments ["<b>Também</b> — agora tocarei a lira; apenas a minha língua medita sempre na Tua justiça sem lira. Portanto, a palavra גם, e ele mencionou que se envergonharam, porque não tenho temor."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 71, :timestamp "2026-07-27T23:36:34.852064578Z", :translated-from :en, :model "glm-5.2"}
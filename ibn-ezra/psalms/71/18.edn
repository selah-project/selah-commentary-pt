{:tier :glm-5.2, :verse 18, :comments ["<b>Teu braço</b> — a força de Teu braço." "<b>À geração</b> — que há de vir." "<b>A todos os que vêm</b> — a todos os que hão de vir. O sentido: que nascerão, como em: 'Uma geração vai e outra geração vem.'"], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 71, :timestamp "2026-07-27T23:36:31.973048909Z", :translated-from :en, :model "glm-5.2"}
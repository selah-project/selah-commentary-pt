{:tier :glm-5.2, :verse 3, :comments ["<b>Para que não despedace</b> — cada um dos meus inimigos, como: «as filhas da estepe pisam sobre mim»" "E o sentido de <b>despedace</b> — pois o leão separa as vértebras do pescoço." "<b>E não há quem salve</b> — senão Tu; portanto, acima: <b>e salva-me.</b>"], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 7, :timestamp "2026-07-27T23:29:16.538606616Z", :translated-from :en, :model "glm-5.2"}
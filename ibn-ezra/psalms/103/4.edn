{:tier :glm-5.2, :verse 4, :comments ["<b>Que resgata</b> — Quantas vezes ele esteve prestes a morrer, e em sua doença ele pensou que morreria." "<b>E o sentido de המעטרכי</b> — que Ele o guiou em sua doença com delicadeza, com bondade e compaixão."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 103, :timestamp "2026-07-27T23:40:34.012391589Z", :translated-from :en, :model "glm-5.2"}
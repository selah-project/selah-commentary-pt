{:tier :glm-5.2, :verse 22, :comments ["<b>Bendizei</b> — todas as Suas obras, a saber, os metais, as plantas e todos os seres viventes, pois Ele neles reina. E depois Ele completou, como começou, <i>Bendize, minh'alma, HaShem</i>."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 103, :timestamp "2026-07-27T23:40:41.957836585Z", :translated-from :en, :model "glm-5.2"}
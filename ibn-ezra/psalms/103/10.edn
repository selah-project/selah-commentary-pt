{:tier :glm-5.2, :verse 10, :comments ["<b>Não</b> — David associa outros a si mesmo, pois Ele mostra bondade a todos. E eis, כעוונותינו (segundo as nossas iniquidades), em correspondência com הסולח לכל עוניכי (aquele que perdoa todas as tuas iniquidades)."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 103, :timestamp "2026-07-27T23:40:36.848411305Z", :translated-from :en, :model "glm-5.2"}
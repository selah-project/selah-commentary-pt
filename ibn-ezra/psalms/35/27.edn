{:tier :glm-5.2, :verse 27, :comments ["<b>Exultem de alegria</b> — Assim como aqueles que se alegram com o meu mal são envergonhados, assim aqueles que desejam ver a minha vindicação se alegrarão, e YHWH será grande, em correspondência àqueles que se engrandecem contra mim."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 35, :timestamp "2026-07-27T23:32:28.313177693Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 4, :comments ["<b>Restaura</b> — o poeta fala na linguagem de Israel." "<b>Como ribeiros</b> — como águas fortes." "<b>No Negev</b> — está sempre quente, por causa do sol, ou conforme a linguagem do Targum: נגובו מיא (as águas secaram)."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 126, :timestamp "2026-07-27T23:44:12.683826109Z", :translated-from :en, :model "glm-5.2"}
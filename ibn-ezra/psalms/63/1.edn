{:tier :glm-5.2, :verse 1, :comments ["<b>Um salmo de David, quando estava no deserto</b> — O motivo deste salmo é que ele ansiava ir a Quiriate-Jearim, o lugar da Arca, porque estava se escondendo de Shaul."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 63, :timestamp "2026-07-27T23:35:23.857121859Z", :translated-from :en, :model "glm-5.2"}
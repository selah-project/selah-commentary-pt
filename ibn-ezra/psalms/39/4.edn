{:tier :glm-5.2, :verse 4, :comments ["<b>se aquece</b> — Meu coração se aquece tanto que, nas minhas reflexões, um fogo arde." "<b>Com a minha língua falei</b> — O sentido é dobrado, ou então é isto que eu falei."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 39, :timestamp "2026-07-27T23:33:01.556077188Z", :translated-from :en, :model "glm-5.2"}
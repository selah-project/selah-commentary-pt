{:tier :glm-5.2, :verse 4, :comments ["<b>Toda</b> — Ele mencionou os seus inimigos próximos e disse: <b>toda a terra</b>. E não há diferença entre יזמרו לך (eles cantam a ti) e ויזמרו לך (e eles cantarão a ti), e o sentido é duplo."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 66, :timestamp "2026-07-27T23:35:41.505344040Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 10, :comments ["<b>אשר</b> — que têm o poder de arquitetar esquemas e tramar meios para aceitar subornos e dinheiro. E alguns dizem: todo o seu propósito é 'tomar na sua mão', e do mesmo modo 'e a sua mão direita', e o sentido é dobrado."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 26, :timestamp "2026-07-27T23:31:23.283446786Z", :translated-from :en, :model "glm-5.2"}
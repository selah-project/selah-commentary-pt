{:tier :glm-5.2, :verse 10, :comments ["<b>Faz cessar</b> — de Jerusalém; talvez pelo Rúaj HaKódesh, concernente ao assunto de Gog." "<b>Queima com fogo</b> — o sentido é 'na Sua ira'; e os wagons que trazem neles as armas, ou o alimento dos combatentes."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 46, :timestamp "2026-07-27T23:33:49.954926454Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 2, :comments ["<b>בגאות</b> — no orgulho do ímpio." "<b>ידלק עני</b> — como ירדף (ele persegue). E o sentido: eles agarram o ímpio — sendo ele o designado, e seus companheiros com ele."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 10, :timestamp "2026-07-27T23:29:37.734000009Z", :translated-from :en, :model "glm-5.2"}
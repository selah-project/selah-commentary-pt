{:tier :glm-5.2, :verse 9, :comments ["<b>Ele repreendeu</b> — Ele comparou o vento oriental a uma repreensão." "<b>Nas profundezas</b> — lugares baixos." "<b>Como um deserto</b> — onde não há água, pois eles lhes foram por muro."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 106, :timestamp "2026-07-27T23:41:19.136215875Z", :translated-from :en, :model "glm-5.2"}
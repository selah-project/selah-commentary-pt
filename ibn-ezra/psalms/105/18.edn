{:tier :glm-5.2, :verse 18, :comments ["<b> aflito</b> — Ele não especificou os verbos, e isso foi enquanto ele estava na prisão." "<b> a sua alma</b> — uma metáfora sobre a sua própria conta. E falta um bet em 'ברזל' (no ferro); 'a sua alma saiu'."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 105, :timestamp "2026-07-27T23:41:04.575250914Z", :translated-from :en, :model "glm-5.2"}
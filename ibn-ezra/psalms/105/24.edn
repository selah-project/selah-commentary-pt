{:tier :glm-5.2, :verse 24, :comments ["<b>E o aumentou</b> — Retornou a שלח מלאך, e a palavra é do binyan pesado [intensivo], o aumentativo." "<b>E o fortaleceu</b> — mais do que seus inimigos — estes são os egípcios."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 105, :timestamp "2026-07-27T23:41:06.438926777Z", :translated-from :en, :model "glm-5.2"}
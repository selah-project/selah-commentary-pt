{:tier :glm-5.2, :verse 4, :comments ["<b>ואבואה אל מזבח אלהים</b> [—] <b>אל</b> — que é a alegria do meu regozijo." "E o sentido de <b>אלהים אלהי</b> — que uma nação ímpia tema, que Tu és meu Elohim."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 43, :timestamp "2026-07-27T23:33:28.201203384Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 16, :comments ["<b>Pois</b> — corresponde aos acontecimentos daqueles que fugiram de uma cidade cujas portas eram de cobre, como se estivessem quebradas. E agora ele mencionará os enfermos."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 107, :timestamp "2026-07-27T23:41:39.078753351Z", :translated-from :en, :model "glm-5.2"}
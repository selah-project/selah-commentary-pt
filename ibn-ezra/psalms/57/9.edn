{:tier :glm-5.2, :verse 9, :comments ["<b>Desperta, minha glória</b> — ele também diz ao nevel: desperta, assim como em <b>eu despertarei a alva</b>, e o verbo é intransitivo [עומד = em pé], como em <b>desperta e levanta-te</b>."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 57, :timestamp "2026-07-27T23:34:56.686922442Z", :translated-from :en, :model "glm-5.2"}
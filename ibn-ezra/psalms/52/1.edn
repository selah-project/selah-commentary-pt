{:tier :glm-5.2, :verse 1, :comments ["<b>Para o mestre de canto, um maskil</b> — o significado: um poema cuja abertura é 'maskil.' E o sentido é declarar que o fim dos ímpios é mau."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 52, :timestamp "2026-07-27T23:34:27.962723387Z", :translated-from :en, :model "glm-5.2"}
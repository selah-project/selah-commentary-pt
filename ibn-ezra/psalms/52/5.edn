{:tier :glm-5.2, :verse 5, :comments ["<b>Amas</b> — mais. E alguns dizem: em vez de. Mas nesta língua não o encontramos." "<b>Mentira</b> — que ele proferiu, embora Ahimelech soubesse que David estava fugindo; por isso foi morto." "<b>Amas</b> — o sentido é: amas o mal."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 52, :timestamp "2026-07-27T23:34:28.895683306Z", :translated-from :en, :model "glm-5.2"}
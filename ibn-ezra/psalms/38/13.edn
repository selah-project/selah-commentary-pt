{:tier :glm-5.2, :verse 13, :comments ["<b>וינקשו</b> — A palavra נפשי rege sobre a de outro, e assim é וינקשו מבקשי נפשי, pois está na forma pu'al. O sentido: as palavras deles são um laço para mim."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 38, :timestamp "2026-07-27T23:32:57.012828051Z", :translated-from :en, :model "glm-5.2"}
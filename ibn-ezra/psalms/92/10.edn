{:tier :glm-5.2, :verse 10, :comments ["<b>Pois eis que os Teus inimigos</b> — Às vezes o maskil ouvia o que acontecia com os ímpios, e também viu o semelhante em seus próprios dias muitas vezes, que os inimigos de HaShem terminam em destruição."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 92, :timestamp "2026-07-27T23:39:38.471325987Z", :translated-from :en, :model "glm-5.2"}
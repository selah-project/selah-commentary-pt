{:tier :glm-5.2, :verse 18, :comments ["<b>Eles clamam</b> — quando se voltam da sua maldade. Alguns dizem: este versículo retorna ao clamor dos justos. A view correta é como eu afirmei, e a testemunha está próxima."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 34, :timestamp "2026-07-27T23:32:15.391348620Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 1, :comments ["<b>Para o regente. Até quando</b> — o sentido: se não for livrado de seus inimigos, ele parecerá morto diante dos olhos dos homens, porque seu Elohim o esqueceu, ou não sabe o que lhe aconteceu."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 13, :timestamp "2026-07-27T23:29:52.212353861Z", :translated-from :en, :model "glm-5.2"}
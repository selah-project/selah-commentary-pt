{:tier :glm-5.2, :verse 2, :comments ["<b>Favoreceste, YHWH, a tua terra</b> — no tempo do Segundo Templo." "<b>Tu levaste</b> — pois por causa da sua iniquidade e do seu pecado eles foram exilados, e a prova é «tu levaste a minha iniquidade»."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 85, :timestamp "2026-07-27T23:38:37.974313753Z", :translated-from :en, :model "glm-5.2"}
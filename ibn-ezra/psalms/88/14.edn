{:tier :glm-5.2, :verse 14, :comments ["<b>E eu</b> — o motivo é \"pela manhã\", pois então a aflição do doente diminui um pouco." "<b>E o sentido de \"meu clamor\"</b> — só a Ti, e não a um curandeiro que não sejas Tu."], :book "psalms", :voice :ibn-ezra, :lang :pt, :chapter 88, :timestamp "2026-07-27T23:38:55.906995029Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 23, :comments ["<b>Ele te deu tesouro.</b> É possível que alguém tivesse um tesouro escondido em sua casa e o tivesse esquecido quando o colocou no armazém, e ele te coube por sorte, pois o teu dinheiro chegou a ele."], :book "genesis", :voice :ibn-ezra, :lang :pt, :chapter 43, :timestamp "2026-07-27T22:52:22.719108838Z", :translated-from :en, :model "glm-5.2"}
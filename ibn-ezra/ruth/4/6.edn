{:tier :glm-5.2, :verse 6, :comments ["<b>Para que não prejudique a minha própria herança.</b> Ele tinha uma grande herdade. E alguns dizem que é uma alusão à sua esposa." "<b>Resgata para ti.</b> Eis que te dei permissão, pois eu não posso."], :book "ruth", :voice :ibn-ezra, :lang :pt, :chapter 4, :timestamp "2026-07-27T23:46:24.290800981Z", :translated-from :en, :model "glm-5.2"}
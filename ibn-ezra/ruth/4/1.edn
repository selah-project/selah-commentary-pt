{:tier :glm-5.2, :verse 1, :comments ["<b>Até a porta.</b> Assim era o costume e a Torá para um tribunal." "<b>Fulano, Almoni.</b> Alguns dizem que vem de 'מופלא', e 'אלמוני' de 'אלם', que ele não tem nome conhecido entre os que falam."], :book "ruth", :voice :ibn-ezra, :lang :pt, :chapter 4, :timestamp "2026-07-27T23:46:22.731442436Z", :translated-from :en, :model "glm-5.2"}
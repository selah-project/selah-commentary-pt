{:tier :glm-5.2, :verse 1, :comments ["<b>Depois</b> Após cinco anos. Alguns dizem que este Haman é Memucan." "<b>Acima de todos os príncipes.</b> O sentido é acima de todos os tronos dos príncipes, pois cada príncipe tem um trono no palácio real."], :book "esther", :voice :ibn-ezra, :lang :pt, :chapter 3, :timestamp "2026-07-27T22:35:46.791142935Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 5, :comments ["<b>Sobre</b> — E se trouxermos a água ou a lenha: sobre o nosso pescoço somos perseguidos. O inimigo nos perseguiu e nos fatigou à toa, pois não nos deixa descansar daquilo que estávamos carregando."], :book "lamentations", :voice :ibn-ezra, :lang :pt, :chapter 5, :timestamp "2026-07-27T23:11:19.256645483Z", :translated-from :en, :model "glm-5.2"}
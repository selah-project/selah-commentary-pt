{:tier :glm-5.2, :verse 12, :comments ["<b>Príncipes</b> — Não temos príncipes para salvar nossos anciãos, pois até eles foram pendurados pelos braços. E alguns dizem que 'pelas suas mãos' se refere de volta aos servos mencionados acima."], :book "lamentations", :voice :ibn-ezra, :lang :pt, :chapter 5, :timestamp "2026-07-27T23:11:22.148200648Z", :translated-from :en, :model "glm-5.2"}
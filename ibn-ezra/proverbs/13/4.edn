{:tier :glm-5.2, :verse 4, :comments ["<b>Deseja</b> — comida." "<b>mas a sua nefesh</b> — do preguiçoso, e nada tem." "<b>mas a nefesh do diligente</b> — dos que se esforçam." "<b>será fartada</b> — será saciada de gordura."], :book "proverbs", :voice :ibn-ezra, :lang :pt, :chapter 13, :timestamp "2026-07-27T23:25:08.759221567Z", :translated-from :en, :model "glm-5.2"}
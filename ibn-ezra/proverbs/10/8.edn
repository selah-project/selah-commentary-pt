{:tier :glm-5.2, :verse 8, :comments ["<b> Sábio de coração</b> — que a sabedoria está em seu coração." "<b> Receberá mandamentos</b> — que outros o ensinarão." "<b> E tolo de lábios</b> — que seus lábios falarão tolice." "<b> Será derrubado</b> — o sentido é, ele tropeçará."], :book "proverbs", :voice :ibn-ezra, :lang :pt, :chapter 10, :timestamp "2026-07-27T23:24:34.388056039Z", :translated-from :en, :model "glm-5.2"}
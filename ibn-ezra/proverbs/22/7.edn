{:tier :glm-5.2, :verse 7, :comments ["<b>Os ricos</b>, <b>semeia</b>, <b>bom</b> — [zayin–tet] três formas unidas. Sobre o pobre que nada tem, ele domina com força, e aquele que dele toma emprestado, ele o compele a ser seu escravo."], :book "proverbs", :voice :ibn-ezra, :lang :pt, :chapter 22, :timestamp "2026-07-27T23:26:49.551773270Z", :translated-from :en, :model "glm-5.2"}
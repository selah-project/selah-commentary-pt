{:tier :glm-5.2, :verse 1, :comments ["<b>Como a neve</b> — que é imprópria no verão, <b>e como a chuva</b> — que é imprópria na colheita; assim a honra é imprópria para o tolo, que os outros o honrem."], :book "proverbs", :voice :ibn-ezra, :lang :pt, :chapter 26, :timestamp "2026-07-27T23:27:33.989084669Z", :translated-from :en, :model "glm-5.2"}
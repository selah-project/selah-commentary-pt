{:tier :glm-5.2, :verse 2, :comments ["<b>Pela transgressão de uma terra</b> — o povo comum tem muitos oficiais que o destroem. E por causa de um homem de entendimento, que conhece o conhecimento, que os fará voltar da sua transgressão, assim o povo permanecerá."], :book "proverbs", :voice :ibn-ezra, :lang :pt, :chapter 28, :timestamp "2026-07-27T23:27:54.041680518Z", :translated-from :en, :model "glm-5.2"}
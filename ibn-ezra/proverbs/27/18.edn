{:tier :glm-5.2, :verse 18, :comments ["<b>Quem guarda uma figueira</b> — É possível que esteja ligado ao que precede, que alguém não deve ser excessivamente áspero com o seu senhor, assim como com o seu amigo; e o senhor honrará aquele que o guarda de toda coisa má."], :book "proverbs", :voice :ibn-ezra, :lang :pt, :chapter 27, :timestamp "2026-07-27T23:27:51.166945017Z", :translated-from :en, :model "glm-5.2"}
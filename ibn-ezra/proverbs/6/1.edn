{:tier :glm-5.2, :verse 1, :comments ["<b>Meu filho, se te tornaste fiador: ateaste com um estranho tuas palmas</b> — Ao estranho que é o credor ateaste tuas palmas, para pagar a dívida. É o laço em que estás apanhado: são as palavras da tua boca."], :book "proverbs", :voice :ibn-ezra, :lang :pt, :chapter 6, :timestamp "2026-07-27T23:23:50.736774182Z", :translated-from :en, :model "glm-5.2"}
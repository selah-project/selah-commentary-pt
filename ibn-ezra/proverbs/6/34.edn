{:tier :glm-5.2, :verse 34, :comments ["<b>O furor de um homem</b> — Pois o ciúme é o berço do furor, e 'homem' é o marido da mulher, pois no ímpeto do seu furor ele teria ciúmes dele, por ter-se deitado com a sua esposa."], :book "proverbs", :voice :ibn-ezra, :lang :pt, :chapter 6, :timestamp "2026-07-27T23:24:00.350888843Z", :translated-from :en, :model "glm-5.2"}
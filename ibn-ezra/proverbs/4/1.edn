{:tier :glm-5.2, :verse 1, :comments ["<b>Ouvi, filhos</b> — Depois de admoestar seu filho, ele repreendeu outros filhos, para que prestassem atenção à disciplina de seu pai, embora sejam tenros; perante o pai ele é considerado como eu."], :book "proverbs", :voice :ibn-ezra, :lang :pt, :chapter 4, :timestamp "2026-07-27T23:23:40.060018139Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 20, :comments ["<b>Pois não haverá fim</b> — e nenhum futuro para o ímpio. O sentido: nenhum filho ou neto lhe restará após a sua morte." "<b>Lâmpada</b> — que a sua alma morrerá antes do seu fim."], :book "proverbs", :voice :ibn-ezra, :lang :pt, :chapter 24, :timestamp "2026-07-27T23:27:17.632854944Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 9, :comments ["<b>Dayan e Aprasatkay Tarphelay</b> — nomes de nações conhecidas entre eles. E é possível que Arachay seja de ve-Arach, Accad e Calné." "<b>Shoshanchay</b> — de Shushan." "<b>Dehavay</b> — de Elão."], :book "ezra", :voice :ibn-ezra, :lang :pt, :chapter 4, :timestamp "2026-07-27T22:46:16.305522489Z", :translated-from :en, :model "glm-5.2"}
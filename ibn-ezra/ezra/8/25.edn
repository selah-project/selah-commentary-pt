{:tier :glm-5.2, :verse 25, :comments ["<b>ההרימו</b> — O heh é aquele que se acrescenta aos verbos transitivos, como <b>ההליכא</b> (o enviar), <b>השבה</b> (o retornar). E a razão é <b>אשר</b>."], :book "ezra", :voice :ibn-ezra, :lang :pt, :chapter 8, :timestamp "2026-07-27T22:46:39.792893132Z", :translated-from :en, :model "glm-5.2"}
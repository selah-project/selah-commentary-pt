{:tier :glm-5.2, :verse 1, :comments ["<b>Ouvi.</b> Estas são as palavras do naví." "<b>De longe.</b> Aqueles que habitam numa terra distante, ou \"de longe\" com respeito ao futuro." "<b>Desde o ventre me chamou.</b> Eu o explicarei no livro de Jeremias."], :book "isaiah", :voice :ibn-ezra, :lang :pt, :chapter 49, :timestamp "2026-07-27T23:02:35.920720584Z", :translated-from :en, :model "glm-5.2"}
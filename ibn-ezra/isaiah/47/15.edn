{:tier :glm-5.2, :verse 15, :comments ["<b>Assim eles se tornaram.</b> A respeito destes sábios." "<b>Com quem labutaste.</b> Que lhes deste dinheiro." "<b>E os teus mercadores.</b> Que não são da tua terra — que foram teus amantes; quando o teu mal veio, eles te abandonaram."], :book "isaiah", :voice :ibn-ezra, :lang :pt, :chapter 47, :timestamp "2026-07-27T23:02:24.268860920Z", :translated-from :en, :model "glm-5.2"}
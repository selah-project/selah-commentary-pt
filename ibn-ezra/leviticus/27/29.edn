{:tier :glm-5.2, :verse 29, :comments ["<b>Será morto.</b> E a palavra <b>yeiḥeram</b> pertence a um binyan cujo nome verbal não é nomeado, como <b>ya'amod</b> <i>ḥai</i> [ficará de pé vivo]."], :book "leviticus", :voice :ibn-ezra, :lang :pt, :chapter 27, :timestamp "2026-07-27T23:15:55.605883392Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 13, :comments ["<b>Ela comerá do pão de seu pai.</b> Como antes." "<b>E nenhum estranho comerá disso.</b> A respeito de um filho, se ela tiver um, e por causa dele também ela não comerá."], :book "leviticus", :voice :ibn-ezra, :lang :pt, :chapter 22, :timestamp "2026-07-27T23:14:35.596137987Z", :translated-from :en, :model "glm-5.2"}
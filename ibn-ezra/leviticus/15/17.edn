{:tier :glm-5.2, :verse 17, :comments ["<b>E toda a vestimenta</b>: Parecer-nos-ia que a lavagem é necessária para a vestimenta ou para a pele, quer o sêmen nela estivesse úmido quer seco, e a verdade está de acordo com a tradição recebida."], :book "leviticus", :voice :ibn-ezra, :lang :pt, :chapter 15, :timestamp "2026-07-27T23:13:18.921863081Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 16, :comments ["<b>Não comerás.</b> Como todas as ofertas de alimentos, pois como o sacerdote comeria a sua oferta de alimentos ou a sua oferta pelo pecado. O lugar de abate de toda oferta pelo pecado é no norte."], :book "leviticus", :voice :ibn-ezra, :lang :pt, :chapter 6, :timestamp "2026-07-27T23:11:54.552986591Z", :translated-from :en, :model "glm-5.2"}
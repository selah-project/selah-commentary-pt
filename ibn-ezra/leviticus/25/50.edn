{:tier :glm-5.2, :verse 50, :comments ["<b>Ele o adquiriu.</b> Com heh e sem heh são equivalentes." "<b>Quem o vendeu.</b> Uma forma verbal do binyan nifal. E os dois que estão com ele serão como os dias de um trabalhador assalariado."], :book "leviticus", :voice :ibn-ezra, :lang :pt, :chapter 25, :timestamp "2026-07-27T23:15:25.340777643Z", :translated-from :en, :model "glm-5.2"}
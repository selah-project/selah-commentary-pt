{:tier :glm-5.2, :verse 10, :comments ["<b>E Amazias enviou</b> — o sacerdote de Betel era o sacerdote do Baal." "<b>No meio</b> — ele falará abertamente e o povo da terra não poderá conter, suportar, e eis que se o fizeres morrer, todos se alegrarão."], :book "amos", :voice :ibn-ezra, :lang :pt, :chapter 7, :timestamp "2026-07-27T22:25:42.329135243Z", :translated-from :en, :model "glm-5.2"}
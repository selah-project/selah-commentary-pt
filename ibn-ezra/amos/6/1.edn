{:tier :glm-5.2, :verse 1, :comments ["<b>Ho:</b> Este é um sinal concernente ao exílio de Nabucodonosor." "<b>O designado primeiro das nações:</b> São Israel, e são chamados 'nações' porque são numerosos." "<b>E a casa de Israel vem a eles:</b> Pois estão sob o seu domínio."], :book "amos", :voice :ibn-ezra, :lang :pt, :chapter 6, :timestamp "2026-07-27T22:25:50.464783642Z", :translated-from :en, :model "glm-5.2"}
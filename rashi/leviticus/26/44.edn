{:tier :glm-5.2, :verse 44, :comments ["<b>E apesar mesmo disso.</b> E mesmo que Eu traga sobre eles esta calamidade que afirmei <b>quando estiverem na terra dos seus inimigos</b> — não os rejeitarei para destruí-los, nem para anular Minha aliança com eles."], :book "leviticus", :voice :rashi, :lang :pt, :chapter 26, :timestamp "2026-08-02T10:15:47.585115315Z", :translated-from :en, :model "glm-5.2"}
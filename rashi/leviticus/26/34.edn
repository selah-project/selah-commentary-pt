{:tier :glm-5.2, :verse 34, :comments ["<b>Então será apaziguada.</b> Apaziguará a ira do Onipresente, que estava irado por causa dos seus anos sabáticos." "<b>E fará aceitação.</b> Para com o Rei — <b>os seus shabatot.</b>"], :book "leviticus", :voice :rashi, :lang :pt, :chapter 26, :timestamp "2026-08-02T10:15:38.387327576Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 18, :comments ["<b>E se mesmo depois destas.</b> E se enquanto estas ainda <b>não ouvirdes</b>." "<b>Eu acrescentarei.</b> Mais castigos além destes." "<b>Sete pelos vossos pecados.</b> Sete punições pelas sete transgressões mencionadas acima."], :book "leviticus", :voice :rashi, :lang :pt, :chapter 26, :timestamp "2026-08-02T10:15:31.797806777Z", :translated-from :en, :model "glm-5.2"}
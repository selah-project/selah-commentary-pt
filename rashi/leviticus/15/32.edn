{:tier :glm-5.2, :verse 32, :comments ["<b>Esta é a torá do zav.</b> Aquele que teve uma única emissão — e qual é a sua torá?" "<b>E do qual a emissão de sêmen sai</b> — ele é como um ba'al keri: impuro com a impureza do entardecer."], :book "leviticus", :voice :rashi, :lang :pt, :chapter 15, :timestamp "2026-08-02T10:13:01.908084465Z", :translated-from :en, :model "glm-5.2"}
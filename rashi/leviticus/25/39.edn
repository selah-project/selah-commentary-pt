{:tier :glm-5.2, :verse 39, :comments ["<b>Trabalho de escravo.</b> Trabalho degradante, no qual seja reconhecível que ele é como um escravo — que não carregue suas vestes atrás de si até o banheiro, e que não calce seus sapatos (cf. Sifra)."], :book "leviticus", :voice :rashi, :lang :pt, :chapter 25, :timestamp "2026-08-02T10:15:16.406482275Z", :translated-from :en, :model "glm-5.2"}
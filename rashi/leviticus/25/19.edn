{:tier :glm-5.2, :verse 19, :comments ["<b>E a terra dará o seu fruto, e habitareis nela com segurança.</b> Para que não temais o sono da seca." "<b>E comereis até a saciedade.</b> Mesmo nas entranhas haja bênção nele (cf. Sifra)."], :book "leviticus", :voice :rashi, :lang :pt, :chapter 25, :timestamp "2026-08-02T10:15:06.385476633Z", :translated-from :en, :model "glm-5.2"}
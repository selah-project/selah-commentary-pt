{:tier :glm-5.2, :verse 20, :comments ["<b>E se não resgatar o campo.</b> Aquele que o consagrou." "<b>E se vendeu.</b> O tesoureiro." "<b>O campo, a outro homem — não será mais resgatado.</b> Para retornar à mão daquele que o consagrou."], :book "leviticus", :voice :rashi, :lang :pt, :chapter 27, :timestamp "2026-08-02T10:15:54.078504087Z", :translated-from :en, :model "glm-5.2"}
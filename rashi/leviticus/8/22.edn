{:tier :glm-5.2, :verse 22, :comments ["<b>O carneiro do preenchimento.</b> O carneiro das oferendas de bem-estar — pois מִלּוּאִים é um termo de שְׁלָמִים, pois eles preenchem e completam os sacerdotes no seu sacerdócio."], :book "leviticus", :voice :rashi, :lang :pt, :chapter 8, :timestamp "2026-08-02T10:11:25.698066799Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 15, :comments ["<b>E purgou o altar.</b> Purgou-o e purificou-o da alienidade, para trazê-lo à santidade." "<b>E o consagrou.</b> Por meio deste serviço." "<b>Para fazer expiação sobre ele.</b> De agora em diante, todas as expiações [vêm sobre ele]."], :book "leviticus", :voice :rashi, :lang :pt, :chapter 8, :timestamp "2026-08-02T10:11:25.511962714Z", :translated-from :en, :model "glm-5.2"}
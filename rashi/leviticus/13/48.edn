{:tier :glm-5.2, :verse 48, :comments ["<b>Em linho ou em lã.</b> De linho ou de lã." "<b>Ou em couro.</b> Este é couro que ainda não recebeu nenhum trabalho." "<b>Ou em qualquer trabalho de couro.</b> Este é couro que já recebeu trabalho."], :book "leviticus", :voice :rashi, :lang :pt, :chapter 13, :timestamp "2026-08-02T10:12:27.434534097Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 29, :comments ["<b>Ai de ti, Moabe.</b> Pois amaldiçoaram a Moabe para que fosse entregue em sua mão (Tanchuma)." "<b>Chemosh.</b> O nome do deus de Moabe." "<b>Ele deu.</b> Aquele que entrega os filhos de Moabe." "<b>Seus sobreviventes</b> — fugitivos e escapados da espada, e suas filhas para o cativeiro, etc."], :book "numbers", :voice :rashi, :lang :pt, :chapter 21, :timestamp "2026-08-02T10:19:37.967763534Z", :translated-from :en, :model "glm-5.2"}
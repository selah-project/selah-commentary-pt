{:tier :glm-5.2, :verse 7, :comments ["<b>E a sua oferta de libação.</b> Vinho." "<b>No lugar santo a derramarás.</b> Sobre o altar são derramadas." "<b>A oferta de libação de bebida forte.</b> Vinho que intoxica — excluindo o vinho direto do lagar (Bava Batra 97)."], :book "numbers", :voice :rashi, :lang :pt, :chapter 28, :timestamp "2026-08-02T10:20:56.657866195Z", :translated-from :en, :model "glm-5.2"}
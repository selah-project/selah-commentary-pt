{:tier :glm-5.2, :verse 25, :comments ["<b>O mishkan.</b> As cortinas inferiores." "<b>E a ohel.</b> As cortinas de pelos de cabra feitas para cobertura." "<b>Sua cobertura.</b> Peles de carneiro e peles de tachash." "<b>E o cortinado da entrada.</b> Este é o vilon."], :book "numbers", :voice :rashi, :lang :pt, :chapter 3, :timestamp "2026-08-02T10:16:12.985444496Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 15, :comments ["<b>Para cobrir as coisas sagradas.</b> A Arca e o Altar." "<b>E todos os utensílios sagrados.</b> A Menorá e seus utensílios de serviço." "<b>E morrerão.</b> Pois se tocarem — são passíveis de morte pelas mãos do Céu."], :book "numbers", :voice :rashi, :lang :pt, :chapter 4, :timestamp "2026-08-02T10:16:21.171557502Z", :translated-from :en, :model "glm-5.2"}
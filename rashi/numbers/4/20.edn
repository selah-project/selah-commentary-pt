{:tier :glm-5.2, :verse 20, :comments ["<b>E não virão para ver, quando o sagrado for embalado.</b> No seu recipiente, como expliquei acima nesta perícope — e estendiam sobre ele um pano específico e o cobriam com uma cobertura específica, e o seu ser embalado é a sua cobertura."], :book "numbers", :voice :rashi, :lang :pt, :chapter 4, :timestamp "2026-08-02T10:16:21.467127795Z", :translated-from :en, :model "glm-5.2"}
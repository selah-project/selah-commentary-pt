{:tier :glm-5.2, :verse 25, :comments ["<b>As cortinas do Tabernáculo.</b> As dez de baixo." "<b>E a Tenda do Encontro.</b> As cortinas de pele de cabra feitas como tenda por cima." "<b>Sua cobertura.</b> As peles de carneiro avermelhadas." "<b>O cortinado da entrada.</b> A cortina oriental."], :book "numbers", :voice :rashi, :lang :pt, :chapter 4, :timestamp "2026-08-02T10:16:22.071577692Z", :translated-from :en, :model "glm-5.2"}
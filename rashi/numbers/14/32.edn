{:tier :glm-5.2, :verse 32, :comments ["<b>E vossos cadáveres — vós.</b> Como o Targum traduz. Porque Ele havia falado sobre os filhos, para trazê-los à terra, e queria dizer 'e vós morrereis' — esta expressão recai aqui para dizer 'vós'."], :book "numbers", :voice :rashi, :lang :pt, :chapter 14, :timestamp "2026-08-02T10:18:13.083006540Z", :translated-from :en, :model "glm-5.2"}
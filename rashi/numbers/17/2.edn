{:tier :glm-5.2, :verse 2, :comments ["<b>E o fogo.</b> Que estava dentro dos incensários." "<b>Espalhai para longe.</b> Sobre o chão, fora dos incensários." "<b>Pois se tornaram santos.</b> Os incensários são proibidos para uso comum, pois foram transformados em utensílios de serviço."], :book "numbers", :voice :rashi, :lang :pt, :chapter 17, :timestamp "2026-08-02T10:18:46.403132007Z", :translated-from :en, :model "glm-5.2"}
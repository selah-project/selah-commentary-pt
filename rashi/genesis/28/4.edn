{:tier :glm-5.2, :verse 4, :comments ["<b>A bênção de Avraham.</b> Que Ele lhe disse: ״וְאֶעֶשְׂךָ לְגוֹי גָּדוֹל״ e ״וְהִתְבָּרְכוּ בְזַרְעֲךָ״ — essas bênçãos foram ditas por sua causa: de ti sairá aquela nação e aquela semente abençoada."], :book "genesis", :voice :rashi, :lang :pt, :chapter 28, :timestamp "2026-08-02T10:05:44.320239920Z", :translated-from :en, :model "glm-5.2"}
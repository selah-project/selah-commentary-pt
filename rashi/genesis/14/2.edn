{:tier :glm-5.2, :verse 2, :comments ["<b>Bera.</b> Ímpio para com o céu e ímpio para com as criaturas." "<b>Birsha.</b> Cresceu ímpio na impiedade." "<b>Shinab.</b> Inimigo de seu Pai nos céus." "<b>Shemeber.</b> Pôs uma asa para voar, saltar e rebelar-se contra o Santo, bendito seja Ele." "<b>Bela.</b> Nome da cidade."], :book "genesis", :voice :rashi, :lang :pt, :chapter 14, :timestamp "2026-08-02T10:03:02.614728729Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 5, :comments ["<b>E no décimo quarto ano.</b> Por causa da rebelião." "<b>Chedorlaomer veio.</b> Como ele era o mentor da campanha, ele entra na parte mais espessa da viga." "<b>E os reis.</b> São três reis." "<b>Os Zuzim.</b> São os Zamzummim."], :book "genesis", :voice :rashi, :lang :pt, :chapter 14, :timestamp "2026-08-02T10:03:03.387770607Z", :translated-from :en, :model "glm-5.2"}
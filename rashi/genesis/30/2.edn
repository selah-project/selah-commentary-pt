{:tier :glm-5.2, :verse 2, :comments ["<b>Em lugar de.</b> Estou eu então em Seu lugar?" "<b>Quem reteve de ti.</b> Dizes que eu deveria fazer como fez meu pai — não sou como meu pai. Meu pai não tinha filhos; eu tenho filhos. De ti Ele reteve, não de mim."], :book "genesis", :voice :rashi, :lang :pt, :chapter 30, :timestamp "2026-08-02T10:06:02.791549148Z", :translated-from :en, :model "glm-5.2"}
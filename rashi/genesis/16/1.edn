{:tier :glm-5.2, :verse 1, :comments ["<b>Uma serva egípcia.</b> Ela era filha do Faraó. Quando viu os milagres que foram feitos por Sara, ela disse: Melhor que minha filha seja uma serva nesta casa do que uma senhora em outra casa."], :book "genesis", :voice :rashi, :lang :pt, :chapter 16, :timestamp "2026-08-02T10:03:23.400955251Z", :translated-from :en, :model "glm-5.2"}
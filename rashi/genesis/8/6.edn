{:tier :glm-5.2, :verse 6, :comments ["<b>Ao fim de quarenta dias.</b> A partir de quando os cumes dos montes foram vistos." "<b>A janela da arca que ele havia feito.</b> Para luz — e não a abertura da arca feita para entrar e sair."], :book "genesis", :voice :rashi, :lang :pt, :chapter 8, :timestamp "2026-08-02T10:02:18.751689983Z", :translated-from :en, :model "glm-5.2"}
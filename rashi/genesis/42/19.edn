{:tier :glm-5.2, :verse 19, :comments ["<b>Para a casa de vosso cárcere.</b> Que agora estais aprisionados nela." "<b>E tu, vai, traze.</b> À casa de teu pai." "<b>Comprai comida para vossas casas.</b> O que comprastes para aliviar a fome da gente de vossas casas."], :book "genesis", :voice :rashi, :lang :pt, :chapter 42, :timestamp "2026-08-02T10:08:31.152375230Z", :translated-from :en, :model "glm-5.2"}
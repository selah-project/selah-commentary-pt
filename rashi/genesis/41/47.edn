{:tier :glm-5.2, :verse 47, :comments ["<b>E a terra produziu.</b> Como o Targum o traduz — e a expressão não está desarraigada da linguagem de fazer." "<b>Para os celeiros.</b> Punhado sobre punhado, mão sobre mão — eles iam armazenando."], :book "genesis", :voice :rashi, :lang :pt, :chapter 41, :timestamp "2026-08-02T10:08:20.419233439Z", :translated-from :en, :model "glm-5.2"}
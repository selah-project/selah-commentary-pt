{:tier :glm-5.2, :verse 23, :comments ["<b>O teu Elohim.</b> No teu mérito — e se o teu mérito não for suficiente, <b>o Elohim de teu pai</b> — no mérito de teu pai. <b>deu-te tesouro</b> nos teus sacos de dinheiro."], :book "genesis", :voice :rashi, :lang :pt, :chapter 43, :timestamp "2026-08-02T10:08:42.340640743Z", :translated-from :en, :model "glm-5.2"}
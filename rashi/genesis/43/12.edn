{:tier :glm-5.2, :verse 12, :comments ["<b>E o dinheiro em dobro.</b> O dobro do que foi da primeira vez." "<b>Tomai em vossa mão.</b> Para comprar alimento — talvez o preço tenha subido." "<b>Talvez tenha sido um erro.</b> Talvez aquele designado sobre a casa o tenha esquecido involuntariamente."], :book "genesis", :voice :rashi, :lang :pt, :chapter 43, :timestamp "2026-08-02T10:08:41.136378818Z", :translated-from :en, :model "glm-5.2"}
{:tier :glm-5.2, :verse 19, :comments ["<b>Eu sou Esav, teu primogênito.</b> Eu sou quem te traz, e Esav é teu primogênito." "<b>Eu fiz.</b> Quantas coisas me falaste." "<b>Senta-te.</b> Um termo de assentar-se à mesa — por isso é traduzido א · ס · ת · ח · ר."], :book "genesis", :voice :rashi, :lang :pt, :chapter 27, :timestamp "2026-08-02T10:05:33.779738221Z", :translated-from :en, :model "glm-5.2"}
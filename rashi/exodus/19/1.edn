{:tier :glm-5.2, :verse 1, :comments ["<b>Neste dia.</b> No primeiro do mês. Teria bastado escrever apenas 'naquele dia' — o que significa 'neste dia'? Que as palavras da Torá sejam novas para você, como se hoje elas tivessem sido dadas (Berakhot 63)."], :book "exodus", :voice :rashi, :lang :pt, :chapter 19, :timestamp "2026-08-02T09:56:39.863261624Z", :translated-from :en, :model "glm-5.2"}
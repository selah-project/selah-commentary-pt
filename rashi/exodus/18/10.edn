{:tier :glm-5.2, :verse 10, :comments ["<b>Que vos tirou da mão do Egito.</b> Uma nação dura." "<b>E da mão de Faraó.</b> Um rei duro." "<b>De debaixo da mão do Egito.</b> Como o Targum traduz — um termo de sujeição e dominação; a 'mão' com a qual os sobrecarregavam é o trabalho."], :book "exodus", :voice :rashi, :lang :pt, :chapter 18, :timestamp "2026-08-02T09:56:31.929017983Z", :translated-from :en, :model "glm-5.2"}
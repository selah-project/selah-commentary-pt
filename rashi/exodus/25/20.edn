{:tier :glm-5.2, :verse 20, :comments ["<b>Estender as asas.</b> Que suas asas não ficassem estendidas deitadas, mas sim abertas e erguidas para cima, acima de suas cabeças — para que houvesse dez palmos de espaço entre as asas e a tampa, como está em Sukká."], :book "exodus", :voice :rashi, :lang :pt, :chapter 25, :timestamp "2026-08-02T09:58:22.097578268Z", :translated-from :en, :model "glm-5.2"}
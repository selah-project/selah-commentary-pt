{:tier :glm-5.2, :verse 2, :comments ["<b>Quando te aproximares da batalha.</b> Próximo à tua partida da fronteira — do limite da tua terra." "<b>E o sacerdote se aproximará.</b> O ungido para isso — e é o chamado 'o ungido para a batalha'." "<b>E falará ao povo.</b> Na língua sagrada (Sotah 42)."], :book "deuteronomy", :voice :rashi, :lang :pt, :chapter 20, :timestamp "2026-08-02T09:50:27.941802097Z", :translated-from :en, :model "glm-5.2"}
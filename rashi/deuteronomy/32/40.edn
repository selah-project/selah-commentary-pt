{:tier :glm-5.2, :verse 40, :comments ["<b>Pois levanto aos céus a Minha mão.</b> No ardor da Minha ira, levanto a Minha mão a Mim mesmo em juramento." "<b>E digo: Como Eu vivo.</b> É uma expressão de juramento: Eu juro <b>Como Eu vivo</b>."], :book "deuteronomy", :voice :rashi, :lang :pt, :chapter 32, :timestamp "2026-08-02T09:52:32.239586913Z", :translated-from :en, :model "glm-5.2"}